index f4b2a2a..c13b05e 100644
--- a/src/models/qwen3.cpp
+++ b/src/models/qwen3.cpp
@@ -1,5 +1,39 @@
 #include "models.h"
 
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+
+namespace {
+
+// NeuTTS-2E appends its 65,536 codec tokens as one contiguous vocabulary
+// range. During speech generation only those tokens and the end marker are
+// valid, so computing the tied output projection for the full 217K vocabulary
+// wastes most of the steady-state decode work. Keep this behind an explicit
+// experimental switch and exact model-shape checks so normal Qwen3 models are
+// unaffected.
+constexpr int64_t NEUTTS_VOCAB_SIZE       = 217232;
+constexpr int64_t NEUTTS_EMBEDDING_SIZE   = 512;
+constexpr int64_t NEUTTS_LAYER_COUNT      = 28;
+constexpr int64_t NEUTTS_SPEECH_END_ID    = 151674;
+constexpr int64_t NEUTTS_SPEECH_FIRST_ID  = 151684;
+constexpr int64_t NEUTTS_SPEECH_TOKEN_CNT = 65536;
+
+bool use_neutts_speech_only_head(const llama_hparams & hparams) {
+    const char * value = std::getenv("LLAMA_NEUTTS_SPEECH_ONLY");
+    return value != nullptr && std::strcmp(value, "1") == 0 &&
+           hparams.n_embd == NEUTTS_EMBEDDING_SIZE &&
+           hparams.n_layer() == NEUTTS_LAYER_COUNT;
+}
+
+bool use_neutts_compact_logits(const llama_hparams & hparams) {
+    const char * value = std::getenv("LLAMA_NEUTTS_COMPACT_LOGITS");
+    return value != nullptr && std::strcmp(value, "1") == 0 &&
+           use_neutts_speech_only_head(hparams);
+}
+
+} // namespace
